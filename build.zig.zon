// SPDX-License-Identifier: BSD-3-Clause
//
// Fork-authored; see FORK-LICENSE.md for the grant and COPYING for upstream terms.

.{
    // Package name and public module.
    .name = .spglib,
    // Version matches the pinned upstream release.
    .version = "2.7.0",
    // Value reported by the toolchain for this package name.
    .fingerprint = 0x35191367c8f3aeca, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    // The nested consumer owns its dependency manifest to avoid a cycle.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // List Zig sources individually to exclude caches under `zig/consumer`.
        "zig/root.zig",
        "zig/ffi.zig",
        "zig/cell.zig",
        "zig/dataset.zig",
        "zig/error.zig",
        "zig/magnetic.zig",
        "zig/symmetry.zig",
        "zig/version.zig",
        // Package tests, examples, and nested consumer.
        "zig/tests",
        "zig/examples",
        "zig/consumer/build.zig",
        "zig/consumer/build.zig.zon",
        "zig/consumer/src",
        // Runtime loader and generator sources.
        "runtime",
        // Upstream sources, headers, and version template; omit database generators.
        "src",
        "include",
        // Upstream C API example and its data files.
        "example/c_api",
        // Upstream licence and fork provenance records.
        "COPYING",
        "NOTICE.md",
        "FORK-LICENSE.md",
        "UPSTREAM.md",
        "CHANGELOG.md",
        "README.md",
        "README.upstream.md",
        "README.zig.md",
        "FORK-NOTES.md",
        // Upstream digests; some records name files omitted from the package.
        "UPSTREAM.sha256",
        // Nix and devenv files; `flake.lock` pins nixpkgs.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // Provenance checker and recorded upstream patches.
        "tools",
        "patches",
        // Exclude build caches and development-environment state.
    },
}
