.{
    // Proof that the fork is consumable as a package. This directory is a
    // separate package: it has its own manifest, depends on the fork by
    // relative path and uses only the exported module and artifact.
    .name = .spglib_consumer,
    .version = "0.0.0",
    // The value the pinned Zig 0.17.0 compiler reports for this package.
    // Changing this has security and trust implications.
    .fingerprint = 0x325ce7e12bdb3825,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .spglib = .{ .path = "../.." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
